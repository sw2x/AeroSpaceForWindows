# Ignore everything in the root by default.
# New root entries must be explicitly added with `git add -f`
# New root directories must be explicitly listed below
/*

# Top level dirs
!/.github
!/Sources
!/dev-docs
!/docs
!/legal
!/script

# Top level important files
!/.editorconfig
!/.gitattributes
!/.gitignore
!/CONTRIBUTING.md
!/Package.resolved
!/Package.swift
!/README.md
!/README.ja.md
!/.swift-version
!/*.ps1
!/LICENSE.txt
!/Tests

.build/
.swiftpm/
.tools/
.release/
.debug/
